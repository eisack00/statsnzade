# Ensure you have rdeck installed via pak or remotes:
# pak::pak("qfes/rdeck")
library(arrow)
library(sf)
library(dplyr)
library(rdeck)
library(viridisLite)
# 1. Connect to the global Overture Maps buildings dataset via S3
# (Using the cloud-native arrow interface to avoid downloading the 2.3B row file)
buildings <- open_dataset('s3://overturemaps-us-west-2/release/2024-05-16-beta.0/theme=buildings?region=us-west-2')
buildings_ds <- open_dataset("s3://overturemaps-us-west-2/release/2026-06-17.0/theme=buildings/type=building/")
# 2. Filter and collect
buildings_sf <- buildings_ds |>
filter(bbox.xmin > 174.5, bbox.xmax < 175.1,
bbox.ymin > -37.1, bbox.ymax < -36.65) |>
select(id, geometry, height) |>
collect() |>
st_as_sf(crs = 4326)
# 2. Define the explicit bounding box for the Auckland metropolitan area
# c(xmin, ymin, xmax, ymax)
auckland_bbox <- c(174.5500, -37.1000, 175.1000, -36.6500)
# 3. Query, stream, and apply cognitive spatial adjustments
ak_buildings <- buildings_ds |>
# Client-side spatial pruning via Overture's metadata bounding box variables
filter(bbox$xmin > auckland_bbox[1],
bbox$ymin > auckland_bbox[2],
bbox$xmax < auckland_bbox[3],
bbox$ymax < auckland_bbox[4]) |>
select(id, geometry, height) |>
# Collect evaluates the lazy query and pulls only the filtered subset into local memory
collect() |>
# Convert the raw data stream into a simple features spatial object
st_as_sf(crs = 4326) |>
mutate(
# Handle missing values: Give unmapped residential/commercial a logical baseline
clean_height = ifelse(is.na(height), 4.5, height),
# Apply Flannery-style non-linear scaling (Perceptual Realism over Literalism)
# Compresses towering CBD high-rises and lifts low-density suburban forms
compensated_height = (clean_height ^ 0.72) * 2.5
)
# 4. Initialize the high-performance deck.gl viewport over Auckland
rdeck(
map_style = mapbox_dark(), # Swapping to dark mode to make the color palettes pop
initial_view_state = view_state(
center = c(174.7633, -36.8485), # Centered squarely over the Auckland CBD / Waitematā
zoom = 13.2,
bearing = -45,
pitch = 70
)
) |>
add_polygon_layer(
data = ak_buildings,
name = "Auckland 3D Footprints",
get_polygon = geometry,
# Inject the perceptually adjusted height calculation directly into the GPU shader
get_elevation = compensated_height,
# Drive the visual color overlay by the original physical height metric
get_fill_color = scale_color_linear(
col = clean_height,
palette = viridisLite::inferno(100, direction = -1)
),
extruded = TRUE,
opacity = 0.75,
wireframe = FALSE
)
rdeck(
map_style = "https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json",
initial_view_state = view_state(
center = c(174.7633, -36.8485),
zoom = 13.5,
bearing = -45,
pitch = 75
)
) |>
add_polygon_layer(
data = ak_buildings,
get_polygon = geometry,
get_elevation = compensated_height,
# Force the "Cyberpunk" purple/neon palette
get_fill_color = scale_color_linear(
col = clean_height,
palette = viridisLite::magma(100) # Magma gives that hot neon orange-to-purple transition
),
extruded = TRUE,
wireframe = TRUE, # Turn on wireframe for that techy grid look
get_line_color = c(255, 0, 255), # Neon Magenta outlines
line_width_min_pixels = 1,
opacity = 0.8
)
rdeck(
map_style = "https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json",
initial_view_state = view_state(
center = c(174.7633, -36.8485),
zoom = 13.5,
bearing = -45,
pitch = 75
)
) |>
add_polygon_layer(
data = ak_buildings,
get_polygon = geometry,
get_elevation = compensated_height,
# Force the "Cyberpunk" purple/neon palette
get_fill_color = scale_color_linear(
col = clean_height,
palette = viridisLite::magma(100) # Magma gives that hot neon orange-to-purple transition
),
extruded = TRUE,
wireframe = TRUE, # Turn on wireframe for that techy grid look
get_line_color = rep(list(c(255, 0, 255)), nrow(ak_buildings)),
line_width_min_pixels = 1,
opacity = 0.8
)
rdeck(
map_style = "https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json",
initial_view_state = view_state(
center = c(174.7633, -36.8485),
zoom = 13.5,
bearing = -45,
pitch = 75
)
) |>
add_polygon_layer(
data = ak_buildings,
get_polygon = geometry,
get_elevation = compensated_height,
get_fill_color = scale_color_linear(
col = clean_height,
palette = viridisLite::magma(100)
),
extruded = TRUE,
wireframe = TRUE,
# Force a single constant color for the lines
get_line_color = "#FF00FF",
line_width_min_pixels = 1,
opacity = 0.8
)
