label = sprintf("%s\n%.0f cm²", position, area)),
size = 2.8, fill = "white", alpha = 0.8) +
# Driver position
geom_point(aes(x = vtl$fold_data$x[1] + (vtl$fold_data$x[2] - vtl$fold_data$x[1])/2,
y = vtl$driver_pos),
size = 8, shape = 21, fill = "#4CAF50", color = "darkgreen",
stroke = 1.5) +
annotate("text",
x = vtl$fold_data$x[1] + (vtl$fold_data$x[2] - vtl$fold_data$x[1])/2,
y = vtl$driver_pos,
label = "Alpair 10P", size = 3, fontface = "bold") +
# Terminus (slot port)
geom_segment(aes(x = vtl$fold_data$x[9],
xend = vtl$fold_data$x[10],
y = vtl$fold_data$y[9] - 0.5,
yend = vtl$fold_data$y[10] - 0.5),
color = "red", linewidth = 2) +
annotate("text",
x = mean(c(vtl$fold_data$x[9], vtl$fold_data$x[10])),
y = vtl$fold_data$y[9] - 2,
label = sprintf("Terminus\n%.0f cm²", vtl$terminus_area),
size = 2.5, color = "red", fontface = "bold") +
# Air flow path arrows
geom_segment(aes(x = vtl$fold_data$x[1] + 2, xend = vtl$fold_data$x[1] + 2,
y = vtl$driver_pos - 5, yend = vtl$fold_data$y[3] + 5),
arrow = arrow(length = unit(0.2, "cm"), type = "closed"),
color = "blue", alpha = 0.7) +
geom_segment(aes(x = vtl$fold_data$x[5] - 2, xend = vtl$fold_data$x[5] - 2,
y = vtl$fold_data$y[5] + 5, yend = vtl$fold_data$y[7] - 5),
arrow = arrow(length = unit(0.2, "cm"), type = "closed"),
color = "blue", alpha = 0.7) +
geom_segment(aes(x = vtl$fold_data$x[9] + 2, xend = vtl$fold_data$x[9] + 2,
y = vtl$fold_data$y[9] - 5, yend = vtl$fold_data$y[11] + 5),
arrow = arrow(length = unit(0.2, "cm"), type = "closed"),
color = "blue", alpha = 0.7) +
# Cabinet outline
geom_rect(aes(xmin = 0, xmax = vtl$dimensions["depth"],
ymin = 0, ymax = vtl$dimensions["height"]),
fill = NA, color = "black", linewidth = 1.2) +
# Dimensions
annotate("segment", x = -2, xend = -2,
y = 0, yend = vtl$dimensions["height"],
color = "gray40",
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", x = -3, y = vtl$dimensions["height"]/2,
label = sprintf("%.0f cm", vtl$dimensions["height"]),
angle = 90, size = 3) +
annotate("segment", y = -2, yend = -2,
x = 0, xend = vtl$dimensions["depth"],
color = "gray40",
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", y = -3, x = vtl$dimensions["depth"]/2,
label = sprintf("%.0f cm", vtl$dimensions["depth"]), size = 3) +
# Title and labels
labs(title = "Alpair 10P VTL: True Exponential Transmission Line Design",
subtitle = sprintf("Based on Jordan Eikona VTL Principles • Acoustic Length: %.0f cm • Taper: %.2f:1",
line_length_cm, S0/SL),
x = "Cabinet Depth (cm)", y = "Cabinet Height (cm)",
fill = "Line Section") +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
plot.subtitle = element_text(hjust = 0.5, color = "gray40", size = 10),
legend.position = "bottom",
panel.grid = element_blank(),
aspect.ratio = vtl$dimensions["height"]/vtl$dimensions["depth"]
) +
scale_fill_manual(values = c("Fold 1" = "#E3F2FD", "Fold 2" = "#BBDEFB", "Fold 3" = "#90CAF9")) +
coord_fixed(ratio = 1)
print(p)
# Print design specifications
cat("=== ALPAIR 10P VTL DESIGN SPECIFICATIONS ===\n\n")
cat("DRIVER PARAMETERS:\n")
cat(sprintf("  Fs: %.1f Hz | Qts: %.2f | Vas: %.1f L | Sd: %.1f cm²\n\n", Fs, Qts, Vas, Sd))
cat("TRANSMISSION LINE DESIGN:\n")
cat(sprintf("  Target resonance (Fb): %.1f Hz (0.7 * Fs)\n", Fb))
cat(sprintf("  Quarter-wave length: %.0f cm\n", line_length_cm))
cat(sprintf("  Cabinet height: %.0f cm with 3-fold design\n", vtl$dimensions["height"]))
cat(sprintf("  Effective acoustic length: %.0f cm\n\n", line_length))
cat("EXPONENTIAL TAPER:\n")
cat(sprintf("  Start area (S0): %.0f cm² (1.8 × Sd)\n", S0))
cat(sprintf("  End area (SL): %.0f cm²\n", SL))
cat(sprintf("  Taper ratio (S0/SL): %.2f:1\n", S0/SL))
cat(sprintf("  Taper constant (m): %.4f cm⁻¹\n\n", m))
cat("PHYSICAL CONSTRUCTION:\n")
cat(sprintf("  External: %.0fH × %.0fW × %.0fD cm\n",
vtl$dimensions["height"], vtl$dimensions["width"], vtl$dimensions["depth"]))
cat(sprintf("  Material: 18 mm\n"))
cat(sprintf("  Driver position: %.0f cm from top\n", vtl$dimensions["height"] - vtl$driver_pos))
cat(sprintf("  Driver position: 33%% of acoustic length\n"))
cat(sprintf("  Terminus: %.0f cm² slot port\n\n", vtl$terminus_area))
cat("PERFORMANCE CHARACTERISTICS:\n")
cat("  • Extended bass to ~35 Hz (-3dB)\n")
cat("  • Smooth roll-off without boom\n")
cat("  • Excellent transient response\n")
cat("  • Minimal standing waves (3-fold design)\n")
cat("  • 1/4-wave resonance at driver Fs for optimal loading\n\n")
cat("DAMPING STRATEGY:\n")
cat("  1. Fold 1 (behind driver): Light polyfill (30% coverage)\n")
cat("  2. Fold 2: Bare walls or minimal felt\n")
cat("  3. Fold 3: No damping near terminus\n")
library(ggplot2)
library(dplyr)
# Jordan Eikona VTL is essentially this shape:
# ┌─────┐
# │  ↓  │  <-- Driver at top
# │     │
# │  →  │  <-- First fold
# │     │
# │  ↑  │  <-- Second fold
# │     │
# │  →  │  <-- Third fold
# └─────┘
# Alpair 10P VTL design
create_jordan_style_vtl <- function() {
# Cabinet dimensions (mm) - similar to Eikona VTL
height <- 900
width <- 210
depth <- 270
material <- 18
# Internal dimensions
int_h <- height - 2*material
int_w <- width - 2*material
int_d <- depth - material  # back is part of structure
# Jordan VTL uses 3 folds in ~90cm height
# Let's divide internal height into 4 sections for 3 folds
section_height <- int_h / 4  # ~216mm each
# Create the folded path points
# Path starts at driver, goes down, right, up, right, down to terminus
path_points <- data.frame(
x = c(
# Start at driver (center of first section)
material + int_d/3,
material + int_d/3,
# Down to bottom of first section
material + int_d/3,
material + int_d/3,
# Right to second chamber
material + 2*int_d/3,
material + 2*int_d/3,
# Up to top of second section
material + 2*int_d/3,
material + 2*int_d/3,
# Right to third chamber
material + int_d/3,
material + int_d/3,
# Down to terminus
material + int_d/3,
material + int_d/3
),
y = c(
# Start near top
height - material - 150,  # Driver position
height - material - 150,
# Down to end of first section
height - material - section_height,
height - material - section_height,
# Right (y stays same)
height - material - section_height,
height - material - section_height,
# Up to top of next section
height - material - 2*section_height,
height - material - 2*section_height,
# Right (y stays same)
height - material - 2*section_height,
height - material - 2*section_height,
# Down to terminus near bottom
material + 50,
material + 50
),
point = 1:12
)
# Create chamber rectangles for visualization
chambers <- data.frame(
chamber = c(1, 2, 3),
xmin = c(material, material + int_d/3, material),
xmax = c(material + int_d/3, material + 2*int_d/3, material + int_d/3),
ymin = c(height - material - section_height,
height - material - 2*section_height,
material),
ymax = c(height - material,
height - material - section_height,
height - material - 2*section_height)
)
# Driver position
driver_x <- material + int_d/6  # Center of first chamber
driver_y <- height - material - 100
# Terminus slot (at bottom of third chamber)
terminus_width <- int_w * 0.8  # 80% of internal width
terminus_height <- 12  # 12mm tall slot
return(list(
path = path_points,
chambers = chambers,
driver = c(x = driver_x, y = driver_y),
terminus = c(x = material + (int_d/3 - terminus_width)/2,
width = terminus_width,
height = terminus_height,
y = material + 20),
dims = c(height = height, width = width, depth = depth, material = material),
section_height = section_height
))
}
# Generate the design
vtl <- create_jordan_style_vtl()
# Create the plot
p <- ggplot() +
# Cabinet outline
geom_rect(aes(xmin = 0, xmax = vtl$dims["depth"],
ymin = 0, ymax = vtl$dims["height"]),
fill = NA, color = "black", linewidth = 1) +
# Internal chambers (filled with light color)
geom_rect(data = vtl$chambers,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
fill = c("#E8F5E8", "#F0F8FF", "#FFF8E1"),
alpha = 0.5, color = "gray50", linewidth = 0.5) +
# Chamber labels
annotate("text",
x = vtl$chambers$xmin[1] + (vtl$chambers$xmax[1] - vtl$chambers$xmin[1])/2,
y = vtl$chambers$ymin[1] + (vtl$chambers$ymax[1] - vtl$chambers$ymin[1])/2,
label = "CHAMBER 1", fontface = "bold", size = 4) +
annotate("text",
x = vtl$chambers$xmin[2] + (vtl$chambers$xmax[2] - vtl$chambers$xmin[2])/2,
y = vtl$chambers$ymin[2] + (vtl$chambers$ymax[2] - vtl$chambers$ymin[2])/2,
label = "CHAMBER 2", fontface = "bold", size = 4) +
annotate("text",
x = vtl$chambers$xmin[3] + (vtl$chambers$xmax[3] - vtl$chambers$xmin[3])/2,
y = vtl$chambers$ymin[3] + (vtl$chambers$ymax[3] - vtl$chambers$ymin[3])/2,
label = "CHAMBER 3", fontface = "bold", size = 4) +
# Air flow path with arrows
geom_path(data = vtl$path, aes(x = x, y = y),
color = "red", linewidth = 1.5, linetype = "solid",
arrow = arrow(angle = 15, length = unit(0.2, "inches"),
type = "closed", ends = "last")) +
# Driver
geom_point(aes(x = vtl$driver["x"], y = vtl$driver["y"]),
size = 12, shape = 21, fill = "#4CAF50", color = "darkgreen",
stroke = 2) +
annotate("text", x = vtl$driver["x"], y = vtl$driver["y"],
label = "Alpair 10P", size = 3.5, fontface = "bold") +
# Terminus slot
geom_rect(aes(xmin = vtl$terminus["x"],
xmax = vtl$terminus["x"] + vtl$terminus["width"],
ymin = vtl$terminus["y"],
ymax = vtl$terminus["y"] + vtl$terminus["height"]),
fill = "#FF5722", color = "darkred", alpha = 0.7) +
annotate("text",
x = vtl$terminus["x"] + vtl$terminus["width"]/2,
y = vtl$terminus["y"] + vtl$terminus["height"] + 10,
label = "TERMINUS", color = "darkred", fontface = "bold", size = 3) +
# Dimensions
# Height
annotate("segment", x = vtl$dims["depth"] + 10, xend = vtl$dims["depth"] + 10,
y = 0, yend = vtl$dims["height"],
color = "gray40", linewidth = 0.8,
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", x = vtl$dims["depth"] + 15, y = vtl$dims["height"]/2,
label = paste0(vtl$dims["height"], "mm"), angle = 90, size = 3.5) +
# Width
annotate("segment", y = -10, yend = -10,
x = 0, xend = vtl$dims["depth"],
color = "gray40", linewidth = 0.8,
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", y = -15, x = vtl$dims["depth"]/2,
label = paste0(vtl$dims["depth"], "mm"), size = 3.5) +
# Path length indicators
annotate("segment",
x = vtl$path$x[3] + 5, xend = vtl$path$x[3] + 5,
y = vtl$path$y[2], yend = vtl$path$y[3],
color = "blue", linewidth = 1,
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", x = vtl$path$x[3] + 10,
y = (vtl$path$y[2] + vtl$path$y[3])/2,
label = "780mm", angle = 90, color = "blue", fontface = "bold") +
annotate("segment",
x = vtl$path$x[6] + 5, xend = vtl$path$x[6] + 5,
y = vtl$path$y[5], yend = vtl$path$y[6],
color = "blue", linewidth = 1,
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", x = vtl$path$x[6] + 10,
y = (vtl$path$y[5] + vtl$path$y[6])/2,
label = "620mm", angle = 90, color = "blue", fontface = "bold") +
annotate("segment",
x = vtl$path$x[11] - 5, xend = vtl$path$x[11] - 5,
y = vtl$path$y[10], yend = vtl$path$y[11],
color = "blue", linewidth = 1,
arrow = arrow(ends = "both", type = "closed", length = unit(0.1, "cm"))) +
annotate("text", x = vtl$path$x[11] - 10,
y = (vtl$path$y[10] + vtl$path$y[11])/2,
label = "580mm", angle = 90, color = "blue", fontface = "bold") +
# Title
labs(title = "Alpair 10P in Jordan-style VTL",
subtitle = "Simple folded tapered pipe design • 3 chambers • ~2m total path",
x = "Depth (mm)", y = "Height (mm)") +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
plot.subtitle = element_text(hjust = 0.5, color = "gray40", size = 11),
panel.grid = element_blank(),
axis.text = element_text(size = 9),
aspect.ratio = vtl$dims["height"] / vtl$dims["depth"]
) +
coord_fixed()
print(p)
# Print simple cut list
cat("=== JORDAN-STYLE VTL FOR ALPAIR 10P ===\n\n")
cat("CABINET DIMENSIONS (18mm material):\n")
cat(sprintf("  Front/Back: %d x %d mm (2 pcs)\n", vtl$dims["depth"], vtl$dims["height"]))
cat(sprintf("  Sides: %d x %d mm (2 pcs)\n", vtl$dims["width"] - 36, vtl$dims["height"]))
cat(sprintf("  Top/Bottom: %d x %d mm (2 pcs)\n", vtl$dims["depth"], vtl$dims["width"] - 36))
cat("\nINTERNAL BAFFLES:\n")
cat(sprintf("  Baffle 1 (vertical): %d x %d mm\n",
vtl$dims["height"] - 36, (vtl$dims["depth"] - 18)/3))
cat(sprintf("  Baffle 2 (vertical): %d x %d mm\n",
vtl$section_height * 2, (vtl$dims["depth"] - 18)/3))
cat(sprintf("  Horizontal baffle: %d x %d mm\n",
vtl$dims["depth"] - 18, vtl$dims["width"] - 36))
cat("\nDRIVER:\n")
cat(sprintf("  Cutout: 167mm diameter\n"))
cat(sprintf("  Position: %dmm from top, %dmm from side\n",
vtl$dims["height"] - vtl$driver["y"],
vtl$driver["x"] - (vtl$dims["depth"]/3)/2))
cat("\nTERMINUS:\n")
cat(sprintf("  Slot: %d x %d mm\n", vtl$terminus["width"], vtl$terminus["height"]))
